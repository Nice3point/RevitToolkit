<Project>

    <!-- Input of the AddInAssemblyGenerator. Lists the project references of the add-in, transitive ones included. -->
    <ItemGroup>
        <CompilerVisibleProperty Include="AddInProjectReferences"/>
    </ItemGroup>

    <!-- The compiler reads an analyzer config value up to the first semicolon. The names are comma-separated. -->
    <Target Name="CollectAddInProjectReferences"
            AfterTargets="ResolveAssemblyReferences"
            BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
        <PropertyGroup>
            <AddInProjectReferences>@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->'%(Filename)', ',')</AddInProjectReferences>
        </PropertyGroup>
    </Target>

</Project>
